NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Behind a reverse proxy / load balancer, set so rate limits and logs see real client IPs:
# "true", a hop count ("1"), or comma-separated trusted proxy IPs/CIDRs. Leave empty otherwise.
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=powerwatch

# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Seconds ("900") or a unit suffix: s, m, h, d ("15m", "30d"). Invalid values fail at startup.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# Max request body size in bytes (default 100 KB).
BODY_LIMIT_BYTES=102400

# Global limit, per IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Login (per email) and register/verify/reset (per IP).
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
# send-otp / resend-otp / forgot-password (per email).
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MS=600000

OTP_EXPIRY_MINUTES=10

# Comma-separated list of allowed origins. "*" is rejected because credentials are enabled.
CORS_ORIGIN=http://localhost:5173

# Optional. Seeds an admin on first start if ADMIN_EMAIL is set.
# ADMIN_PASSWORD is required when ADMIN_EMAIL is set and must meet the password policy
# (8+ chars with upper, lower, number and symbol). Never commit a real value.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact address sent to OpenStreetMap Nominatim in the User-Agent (defaults to SMTP_FROM_EMAIL).
NOMINATIM_CONTACT_EMAIL=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@powerwatch.com
SMTP_FROM_NAME=PowerWatch

# Public base URL shown in Swagger (non-production only).
API_SERVER_URL=
