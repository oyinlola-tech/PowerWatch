# PowerWatch API base URL. Used to fetch the latest published Android release
# for the Download section. Defaults to production when empty.
VITE_API_URL=

# Store listings. Leave empty until the app is published. Android downloads
# straight from the API once a release exists, regardless of this value; set
# VITE_PLAY_STORE_URL once the Play Store listing is live to show it alongside
# the APK button.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Mixpanel project token. Analytics are skipped when this is empty.
VITE_MIXPANEL_TOKEN=

# Shown under "Contact us" in the Privacy Policy and Terms. Nigerian data protection law
# requires the operator's identity and contact details to be published: set these before release.
# Use the same values as the mobile app.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
# Only if data protection requests go to a different address.
VITE_DATA_PROTECTION_EMAIL=
