# Backend base URL (no trailing slash), e.g. https://api.powerwatch.ng
# Leave empty in development: the app then uses the computer running `expo start`
# on port 3000. Required for EAS builds (APKs), and the phone must be able to reach it.
EXPO_PUBLIC_API_URL=

# Mixpanel project token. Analytics are skipped when this is empty.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Google Sign-In (Google Cloud project "powerwatch141"). These are OAuth client IDs,
# not secrets — safe to commit/expose in the built app.
# Web client ID: the API verifies Google ID tokens issued to this audience, and it's
# also required by the native SDK (on both platforms) to receive an idToken it can send.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=387458458442-70qgjv004ffo2bkhh1nu6arshdn7l2r4.apps.googleusercontent.com
# iOS client ID: used by the native SDK on iOS only (bundle com.powerwatch.app).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=387458458442-8d0voqu3u6os7pf6139bf7n9u6ervqu8.apps.googleusercontent.com
# There is no EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID: the Android OAuth client
# (387458458442-ofglme8elijkon89dm3qqbkoo20lsok4.apps.googleusercontent.com) is matched
# automatically by Google Play Services from the app's package name (com.powerwatch.app)
# and signing certificate SHA-1, registered in the Google Cloud console — it's never
# referenced from app code. If the app is later signed with a different key (e.g. Google
# Play App Signing), add that key's SHA-1 to the Android OAuth client in Cloud Console.

# Sign in with Apple is not wired up yet (no Apple Developer membership). Set to "1"
# once expo-apple-authentication is installed and configured to switch the button on.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=

# Shown under "Contact us" in the Privacy Policy and Terms. Nigerian data protection law
# requires the operator's identity and contact details to be published: set these before release.
EXPO_PUBLIC_LEGAL_NAME=
EXPO_PUBLIC_LEGAL_ADDRESS=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Only if data protection requests go to a different address.
EXPO_PUBLIC_DATA_PROTECTION_EMAIL=

# Test builds only: allows a plain http:// EXPO_PUBLIC_API_URL outside development.
# Never set this for a store build.
EXPO_PUBLIC_ALLOW_INSECURE_API=
