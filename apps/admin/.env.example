# Base URL of the PowerWatch API, without /api/v1 and without a trailing slash.
# Development defaults to http://localhost:3000 when this is not set.
# Production builds default to https://api-powerwatch.telente.site when this is not set.
# If you change the production value, also change connect-src in vercel.json.
VITE_API_URL=http://localhost:3000
